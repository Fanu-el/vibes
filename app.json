{
  "expo": {
    "name": "vibes",
    "slug": "vibes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vibes-icons/logo-with-icon.svg",
    "scheme": "vibes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/vibes-icons/logo-with-icon.svg",
        "backgroundImage": "./assets/vibes-icons/logo-with-icon.svg",
        "monochromeImage": "./assets/vibes-icons/logo-with-icon.svg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vibes-icons/logo-only.svg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
